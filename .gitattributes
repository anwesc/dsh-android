*.apk binary
*.png binary
*.jar binary
*.so binary
app/src/main/assets/runtime/proot binary
app/src/main/assets/runtime/libexec/loader binary

# Shell scripts must keep LF or the shebang / `then` lines break on Linux checkouts.
*.sh text eol=lf

# Bundled plugin + its generated asset copy are compared byte-for-byte by
# scripts/sync-plugin-seed.sh --check; CRLF conversion would make them drift.
plugins/qqbot-guard/* text eol=lf
app/src/main/assets/plugin-seed/** text eol=lf


# Binary assets under the plugin seed must never be normalized, even though the
# line above marks the whole seed tree as text.
app/src/main/assets/plugin-seed/**/*.png -text
app/src/main/assets/plugin-seed/**/*.jpg -text
app/src/main/assets/plugin-seed/**/*.jpeg -text
app/src/main/assets/plugin-seed/**/*.webp -text
app/src/main/assets/plugin-seed/**/*.gif -text
app/src/main/assets/plugin-seed/**/*.mp3 -text
