{
  "name": "dsh-qqbot-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh-android 内置的 qqbot 增强层：群聊关键词放行 + 历史上下文 + 进程内补丁（不改 qqbot 文件）",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "selfcheck": "node selfcheck.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@tencent-connect/dsh-qqbot": ">=0.5.3"
  },
  "peerDependenciesMeta": {
    "@tencent-connect/dsh-qqbot": {
      "optional": true
    }
  }
}
